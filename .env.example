# Copy to .env and fill in your own development values. Never commit .env.
# All variables except NEXT_PUBLIC_* are server-only.

# --- Neon Postgres ---
# Pooled connection (hostname contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection, used by the Prisma CLI for migrations and seeding.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (NextAuth.js v5) ---
# Generate with: openssl rand -base64 32   (NEXTAUTH_SECRET is also accepted)
AUTH_SECRET="replace_with_a_long_random_secret"
# Base URL of the app. Required for `pnpm start` outside Vercel. (NEXTAUTH_URL is also accepted)
AUTH_URL="http://localhost:3000"

# --- Neon Object Storage (S3-compatible), private bucket "assets" ---
# From Neon Console > Connect > Storage, or `neon env pull`. Needs storage:read and storage:write.
AWS_ENDPOINT_URL_S3="https://BRANCH_ID.storage.REGION.aws.neon.tech"
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID="nak_live_replace_me"
AWS_SECRET_ACCESS_KEY="nsk_live_replace_me"

# --- Admin account seed (optional, used by `pnpm db:seed`) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Soro Admin"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
